{
  "name": "new-deepnotes",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @deepnotes/db exec drizzle-kit generate",
    "db:migrate": "pnpm --filter @deepnotes/db exec drizzle-kit migrate",
    "db:studio": "pnpm --filter @deepnotes/db exec drizzle-kit studio",
    "db:check": "pnpm --filter @deepnotes/db exec drizzle-kit check"
  },
  "pnpm": {
    "overrides": {
      "libsodium-wrappers-sumo": "^0.8.0",
      "@tiptap/core": "3.22.4",
      "@tiptap/pm": "3.22.4",
      "@tiptap/extensions": "3.22.4",
      "@tiptap/extension-bold": "3.22.4",
      "@tiptap/extension-code": "3.22.4",
      "@tiptap/extension-text": "3.22.4",
      "@tiptap/extension-strike": "3.22.4",
      "@tiptap/extension-italic": "3.22.4",
      "@tiptap/extension-document": "3.22.4",
      "@tiptap/extension-paragraph": "3.22.4",
      "@tiptap/extension-hard-break": "3.22.4",
      "@tiptap/extension-heading": "3.22.4",
      "@tiptap/extension-blockquote": "3.22.4",
      "@tiptap/extension-code-block": "3.22.4",
      "@tiptap/extension-list": "3.22.4",
      "@tiptap/extension-bubble-menu": "3.22.4",
      "@tiptap/extension-floating-menu": "3.22.4"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "eslint": "^9.25.0",
    "turbo": "^2.5.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.31.0"
  }
}
