# Copy to .env for local development (see docker-compose.yml).

# PostgreSQL — used by Drizzle CLI, integration tests, and Wrangler Hyperdrive localConnectionString
DATABASE_URL=postgresql://deepnotes:deepnotes@localhost:5433/deepnotes

# Admin catalog URL (CREATEDB) for @deepnotes/db template-clone tests — defaults to …/postgres from DATABASE_URL if unset
# DATABASE_ADMIN_URL=postgresql://deepnotes:deepnotes@localhost:5433/postgres

# Standard Redis (not KeyDB). TCP URL for Node; Workers may use Upstash HTTP or REDIS_URL via TCP where supported
REDIS_URL=redis://localhost:6380

# API worker (Wrangler secrets in production)
# JWT_SECRET=
# STRIPE_WEBHOOK_SECRET=
